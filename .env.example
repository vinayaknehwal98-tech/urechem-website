# Persistent rate limiting for Vercel/serverless production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only enquiry delivery
RESEND_API_KEY=
URECHEM_ENQUIRY_EMAIL=sales@urechem.co.in
# Must be an email address whose sending domain is verified in Resend.
URECHEM_FROM_EMAIL=

# Comma-separated trusted website origins
URECHEM_ALLOWED_ORIGINS=https://urechem-website.vercel.app

# Public contact address used only for the mailto fallback
NEXT_PUBLIC_URECHEM_ENQUIRY_EMAIL=sales@urechem.co.in
